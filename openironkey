#!/usr/bin/env python3
"""
OpenIronKey - Main Entry Point
"""

import sys
import os

# Add src to path
sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'src'))

def main():
    if len(sys.argv) < 2:
        print("OpenIronKey - IronKey S200 Linux Toolkit")
        print("Usage: openironkey <command> [args...]")
        print()
        print("Commands:")
        print("  cli       - Command line interface")
        print("  applet    - Applet launcher")
        print("  gui       - GTK4 GUI (requires pygobject)")
        print("  scsi      - SCSI driver test")
        print("  pkcs11    - PKCS#11 module test")
        return 1
    
    command = sys.argv[1]
    args = sys.argv[2:]
    
    if command == "cli":
        from openironkey.cli.ironkey_cli import main as cli_main
        sys.argv = ["openironkey_cli"] + args
        return cli_main()
    
    elif command == "applet":
        from openironkey.applet.ironkey_applet import main as applet_main
        sys.argv = ["openironkey_applet"] + args
        return applet_main()
    
    elif command == "gui":
        from openironkey.gui.ironkey_gui import main as gui_main
        sys.argv = ["openironkey_gui"] + args
        return gui_main()
    
    elif command == "scsi":
        from openironkey.scsi.ironkey_scsi import main as scsi_main
        sys.argv = ["openironkey_scsi"] + args
        return scsi_main()
    
    elif command == "pkcs11":
        from openironkey.pkcs11.ironkey_pkcs11 import main as pkcs11_main
        sys.argv = ["openironkey_pkcs11"] + args
        return pkcs11_main()
    
    else:
        print(f"Unknown command: {command}")
        return 1

if __name__ == "__main__":
    sys.exit(main())